# ============================================================
#  AO3 书签备份器 —— 配置样例
#  用法：cp .env.example .env  然后按需修改
# ============================================================

# ---------- 必填 ----------
# 要备份谁的书签。填 AO3 用户名（个人主页 URL 里的那段），不是邮箱。
# 例：https://archiveofourown.org/users/astolat/bookmarks  ->  astolat
BOOKMARK_USER=

# ---------- 登录（可选） ----------
# 不填也能用，但只能看到公开书签与公开作品。
# 想备份「私有书签」和「仅登录可见的作品（蓝锁）」，必须填。
# 常驻运行时若 Cookie 过期会自动重新登录；若登录失败会中止当轮避免静默漏备。
# 注意：AO3 没有应用专用密码，这里只能填真实密码，
#       所以务必保证 .env 不进 git、不共享。
AO3_USER=
AO3_PASSWORD=

# ---------- 调度（二选一，可在 SQLite 总览覆盖） ----------
# 1) 每天固定时刻（容器时区，默认 Asia/Shanghai）
RUN_AT=03:30
# 2) 固定间隔，支持 90m / 6h / 1d；设置后优先于 RUN_AT
# INTERVAL=6h

# 容器启动后是否立刻先跑一轮（1=是，0=否，只等计划时间）
RUN_ON_START=1

# ---------- 网络与代理 ----------
# 每次请求之间的间隔秒数。AO3 是公益站点，别调太小。
DELAY=1.5
# 单次请求超时（秒）
TIMEOUT=60
# 单次请求的总尝试次数（含首次。遇到 HTTP 429 会遵循 Retry-After 等待）
RETRIES=4
# 优先用 IPv4。某些代理/网络下 DNS 先返回不可达的 IPv6，
# 会让每次请求凭空多等 20~40 秒，保持 1 即可。
PREFER_IPV4=1
# HTTP/HTTPS 代理（可选，注意标准库不支持 socks5://，请用 http:// 代理端口）：
# 容器访问宿主机上的代理可填 http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
# HTTP_PROXY=http://host.docker.internal:7890

# ---------- 行为 ----------
# 最多翻多少页书签（每页 20 条）
MAX_PAGES=200
# 同一篇连续失败多少次后暂停重试（作品更新或补填登录态后会自动恢复重试）
MAX_ERRORS=5
# 旧版文件模式专用（--legacy-files）。SQLite 模式会保存各版。
KEEP_VERSIONS=1
# 连续多少页都没有变化就提前结束翻页（0=不启用，每次翻完全部书签页）。
# 启用后会自动对「收藏时间」和「作品更新时间」各做一次增量扫描，兼顾新收藏与老连载更新。
STOP_AFTER_IDLE_PAGES=0
# 可选的 AO3 附件。none 只保存可阅读、比较和导出的文章数据。
# 也可填写以逗号分隔的 html,epub,pdf,mobi,azw3。旧文件模式至少需要一种格式。
FORMATS=none

# Web 在 Docker 宿主机上的监听地址和端口。
# 改成 NAS 的局域网 IPv4 地址后，同网段设备可通过该地址访问。
WEB_BIND_IP=127.0.0.1
WEB_PORT=8765
# 经带认证的 HTTPS 反向代理访问时，填写代理公开的域名并启用 Secure Cookie。
# WEB_ALLOWED_HOSTS=ao3.example.net
# WEB_COOKIE_SECURE=1

# ---------- 健康检查 ----------
# 上次成功运行距今超过多少小时就标记为 unhealthy（0=不检查；任务运行期间保持 healthy）
HEALTHCHECK_MAX_AGE_HOURS=48

# ---------- 时区 ----------
TZ=Asia/Shanghai
