# ============================================================
#  AO3 书签备份器 —— 部署环境变量样例
#  用法：cp .env.example .env  按需修改网络与时区配置
#
#  说明：
#  - 书签用户名、AO3 登录凭据（加密存库或仅存 Cookie）、抓取计划、
#    附件格式与高级抓取参数均在网页端初始化向导与设置页管理。
#  - 首次启动后请打开网页完成初始化，一次性初始化口令会打印在容器日志中。
# ============================================================

# ---------- Web 访问与安全 ----------
# Web 在 Docker 宿主机上的监听地址和端口。
# 改成 NAS 的局域网 IPv4 地址后，同网段设备可通过该地址访问。
WEB_BIND_IP=127.0.0.1
WEB_PORT=8765

# 经带认证的 HTTPS 反向代理访问时，填写代理公开的域名或局域网主机名，
# 并按实际协议设置 WEB_COOKIE_SECURE（纯 HTTP 直连务必设为 0，HTTPS 设 1）。
# WEB_ALLOWED_HOSTS=ao3.example.net
# WEB_COOKIE_SECURE=0

# ---------- 时区 ----------
TZ=Asia/Shanghai

# ---------- 网络代理（可选） ----------
# 注意标准库 urllib 不支持 socks5://，请填写宿主机的 HTTP 代理端口：
# HTTPS_PROXY=http://host.docker.internal:7890
# HTTP_PROXY=http://host.docker.internal:7890

# ---------- 进阶运维（一般无需修改） ----------
# 上次成功运行距今超过多少小时将容器标记为 unhealthy（0=不检查）
# HEALTHCHECK_MAX_AGE_HOURS=48

# 可选：自定义用于加密存储 AO3 密码的主密钥，未填写时自动在 /data/.credentials.key 生成。
# AO3_MASTER_KEY=
